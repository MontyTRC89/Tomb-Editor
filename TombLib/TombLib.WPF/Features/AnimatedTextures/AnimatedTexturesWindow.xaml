<Window
	x:Class="TombLib.WPF.Features.AnimatedTextures.AnimatedTexturesWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:DarkUI.WPF.CustomControls;assembly=DarkUI.WPF"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:darkUI="clr-namespace:DarkUI.WPF;assembly=DarkUI.WPF"
	xmlns:local="clr-namespace:TombLib.WPF.Features.AnimatedTextures"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
	Title="Animated textures"
	Width="900"
	Height="700"
	MinWidth="720"
	MinHeight="520"
	d:DataContext="{d:DesignInstance Type=local:AnimatedTexturesWindowViewModel}"
	Background="{DynamicResource Brush_Background}"
	Style="{DynamicResource CustomWindowStyle}"
	WindowStartupLocation="CenterOwner"
	mc:Ignorable="d">

	<Window.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVis" />
	</Window.Resources>

	<DockPanel Margin="{x:Static darkUI:Defaults.MediumThickness}" LastChildFill="True">

		<controls:SpacedStack
			DockPanel.Dock="Bottom"
			Margin="0,8,0,0"
			HorizontalAlignment="Right"
			Orientation="Horizontal"
			Spacing="{x:Static darkUI:Defaults.MediumThicknessWidth}">
			<Button Width="80" Command="{Binding OkCommand}" Content="OK" IsDefault="True" />
			<Button Width="80" Command="{Binding CancelCommand}" Content="Cancel" IsCancel="True" />
		</controls:SpacedStack>

		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" MinWidth="300" />
				<ColumnDefinition Width="6" />
				<ColumnDefinition Width="380" MinWidth="320" />
			</Grid.ColumnDefinitions>

			<!--  Texture map (hosted WinForms control)  -->
			<Border Grid.Column="0" BorderBrush="{DynamicResource Brush_Border}" BorderThickness="1">
				<wfi:WindowsFormsHost x:Name="textureMapHost" Background="{DynamicResource Brush_Background_Low}" />
			</Border>

			<GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" />

			<!--  Right panel  -->
			<DockPanel Grid.Column="2">

				<!--  Set selection  -->
				<TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" Text="Animation set:" />
				<controls:SpacedStack
					DockPanel.Dock="Top"
					Margin="0,0,0,4"
					Orientation="Horizontal"
					Spacing="{x:Static darkUI:Defaults.SmallThicknessWidth}">
					<Button Width="48" Command="{Binding NewSetCommand}" Content="New" />
					<Button Width="52" Command="{Binding CloneSetCommand}" Content="Clone" />
					<Button Width="56" Command="{Binding DeleteSetCommand}" Content="Delete" />
				</controls:SpacedStack>
				<ComboBox
					DockPanel.Dock="Top"
					Margin="0,0,0,6"
					DisplayMemberPath="Name"
					ItemsSource="{Binding Sets}"
					SelectedItem="{Binding SelectedSet, Mode=TwoWay}" />

				<!--  Settings + name (enabled when a set is selected)  -->
				<StackPanel DockPanel.Dock="Top" IsEnabled="{Binding HasSelectedSet}">
					<TextBlock Margin="0,0,0,4" Text="Name:" />
					<TextBox Margin="0,0,0,6" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

					<!--  Effect  -->
					<Grid Margin="0,0,0,4">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="70" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Effect:" />
						<ComboBox
							Grid.Column="1"
							ItemsSource="{Binding AnimationTypes}"
							SelectedItem="{Binding SelectedAnimationType, Mode=TwoWay}" />
					</Grid>

					<!--  FPS (numeric)  -->
					<Grid Margin="0,0,0,4" Visibility="{Binding ShowFpsNumeric, Converter={StaticResource BoolToVis}}">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="70" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Column="0" VerticalAlignment="Center" Text="FPS:" />
						<controls:NumericUpDown
							Grid.Column="1"
							DecimalPlaces="2"
							IsEnabled="{Binding FpsNumericEnabled}"
							Maximum="120"
							Minimum="0"
							Value="{Binding Fps, Mode=TwoWay}" />
					</Grid>

					<!--  FPS (TRNG predefined)  -->
					<Grid Margin="0,0,0,4" Visibility="{Binding ShowNgFpsCombo, Converter={StaticResource BoolToVis}}">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="70" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Column="0" VerticalAlignment="Center" Text="FPS:" />
						<ComboBox
							Grid.Column="1"
							DisplayMemberPath="Display"
							ItemsSource="{Binding NgFpsOptions}"
							SelectedItem="{Binding SelectedNgFps, Mode=TwoWay}" />
					</Grid>

					<!--  UvRotate (TRNG)  -->
					<Grid Margin="0,0,0,4" Visibility="{Binding ShowNgUvRotateCombo, Converter={StaticResource BoolToVis}}">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="70" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Column="0" VerticalAlignment="Center" Text="UvRotate:" />
						<ComboBox
							Grid.Column="1"
							DisplayMemberPath="Display"
							IsEnabled="{Binding NgUvRotateEnabled}"
							ItemsSource="{Binding NgUvRotateOptions}"
							SelectedItem="{Binding SelectedNgUvRotate, Mode=TwoWay}" />
					</Grid>

					<!--  UVRotate (TombEngine)  -->
					<Grid Margin="0,0,0,4" Visibility="{Binding ShowTeUvRotate, Converter={StaticResource BoolToVis}}">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="70" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="70" />
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Cycles/s:" />
						<controls:NumericUpDown
							Grid.Column="1"
							DecimalPlaces="2"
							Maximum="120"
							Minimum="0"
							Value="{Binding TenUvRotateSpeed, Mode=TwoWay}" />
						<TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="10,0,6,0" Text="Dir°:" />
						<controls:NumericUpDown
							Grid.Column="3"
							DecimalPlaces="0"
							Maximum="360"
							Minimum="-360"
							Value="{Binding TenUvRotateDirection, Mode=TwoWay}" />
					</Grid>
				</StackPanel>

				<!--  Procedural animation generator  -->
				<GroupBox DockPanel.Dock="Top" Margin="0,0,0,6" Header="Procedural animation">
					<StackPanel>
						<ComboBox
							Margin="0,0,0,4"
							DisplayMemberPath="Display"
							ItemsSource="{Binding ProceduralPresets}"
							SelectedItem="{Binding SelectedPreset, Mode=TwoWay}" />
						<Grid Margin="0,0,0,4">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0" Text="Frames:" />
							<controls:NumericUpDown Grid.Column="1" Maximum="256" Minimum="1" Value="{Binding GenFrameCount, Mode=TwoWay}" />
							<TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="10,0,6,0" Text="Strength:" />
							<controls:NumericUpDown Grid.Column="3" Maximum="100" Minimum="0" Value="{Binding GenStrength, Mode=TwoWay}" />
						</Grid>
						<controls:SpacedStack Margin="0,0,0,4" Orientation="Horizontal" Spacing="{x:Static darkUI:Defaults.MediumThicknessWidth}">
							<CheckBox Content="Smooth" IsChecked="{Binding GenSmooth, Mode=TwoWay}" />
							<CheckBox Content="Loop" IsChecked="{Binding GenLoop, Mode=TwoWay}" />
						</controls:SpacedStack>
						<controls:SpacedStack Orientation="Horizontal" Spacing="{x:Static darkUI:Defaults.SmallThicknessWidth}">
							<Button Width="52" Command="{Binding GenerateNewCommand}" Content="New" />
							<Button Width="52" Command="{Binding GenerateCloneCommand}" Content="Clone" IsEnabled="{Binding HasSelectedSet}" />
							<Button Width="56" Command="{Binding GenerateMergeCommand}" Content="Merge" IsEnabled="{Binding HasSelectedSet}" />
							<Button Width="60" Command="{Binding GenerateReplaceCommand}" Content="Replace" IsEnabled="{Binding HasSelectedSet}" />
							<Button Width="44" Command="{Binding GenerateAddFramesCommand}" Content="Add" IsEnabled="{Binding HasSelectedSet}" />
						</controls:SpacedStack>
					</StackPanel>
				</GroupBox>

				<!--  Frame controls  -->
				<controls:SpacedStack
					DockPanel.Dock="Bottom"
					Margin="0,6,0,0"
					IsEnabled="{Binding HasSelectedSet}"
					Orientation="Horizontal"
					Spacing="{x:Static darkUI:Defaults.SmallThicknessWidth}">
					<Button Width="90" Command="{Binding AddFrameCommand}" Content="Add frame" />
					<Button Width="90" Command="{Binding UpdateFrameCommand}" Content="Update frame" />
				</controls:SpacedStack>

				<TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" Text="Frames:" />
				<DataGrid
					x:Name="framesGrid"
					AutoGenerateColumns="False"
					CanUserAddRows="False"
					CanUserDeleteRows="True"
					IsEnabled="{Binding HasSelectedSet}"
					ItemsSource="{Binding Frames}"
					SelectedItem="{Binding SelectedFrame, Mode=TwoWay}">
					<DataGrid.Columns>
						<DataGridTemplateColumn Width="*" Header="Texture">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<TextBlock Margin="4,0" VerticalAlignment="Center" Text="{Binding Texture}" TextTrimming="CharacterEllipsis" />
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
							<DataGridTemplateColumn.CellEditingTemplate>
								<DataTemplate>
									<ComboBox
										ItemsSource="{Binding DataContext.AvailableTextures, RelativeSource={RelativeSource AncestorType=DataGrid}}"
										SelectedItem="{Binding Texture, UpdateSourceTrigger=PropertyChanged}" />
								</DataTemplate>
							</DataGridTemplateColumn.CellEditingTemplate>
						</DataGridTemplateColumn>
						<DataGridTextColumn
							Width="Auto"
							Binding="{Binding Area}"
							Header="Area"
							IsReadOnly="True" />
						<DataGridTextColumn
							Width="60"
							Binding="{Binding Repeat, Mode=TwoWay}"
							Header="Repeat" />
					</DataGrid.Columns>
				</DataGrid>
			</DockPanel>
		</Grid>
	</DockPanel>
</Window>
