<Window
	x:Class="TombLib.WPF.Features.AnimatedTextures.AnimatedTexturesWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:DarkUI.WPF.CustomControls;assembly=DarkUI.WPF"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:darkUI="clr-namespace:DarkUI.WPF;assembly=DarkUI.WPF"
	xmlns:local="clr-namespace:TombLib.WPF.Features.AnimatedTextures"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="Animated textures"
	Width="880"
	Height="680"
	MinWidth="760"
	MinHeight="560"
	d:DataContext="{d:DesignInstance Type=local:AnimatedTexturesWindowViewModel}"
	Background="{DynamicResource Brush_Background}"
	Style="{DynamicResource CustomWindowStyle}"
	WindowStartupLocation="CenterOwner"
	mc:Ignorable="d">

	<Window.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVis" />
		<local:FrameThumbnailConverter x:Key="FrameThumb" />
	</Window.Resources>

	<DockPanel Margin="{x:Static darkUI:Defaults.MediumThickness}" LastChildFill="True">

		<controls:SpacedStack
			DockPanel.Dock="Bottom"
			Margin="0,8,0,0"
			HorizontalAlignment="Right"
			Orientation="Horizontal"
			Spacing="{x:Static darkUI:Defaults.MediumThicknessWidth}">
			<Button Width="80" Command="{Binding OkCommand}" Content="OK" IsDefault="True" />
			<Button Width="80" Command="{Binding CancelCommand}" Content="Cancel" IsCancel="True" />
		</controls:SpacedStack>

		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="56*" MinWidth="380" />
				<ColumnDefinition Width="6" />
				<ColumnDefinition Width="43*" MinWidth="280" />
			</Grid.ColumnDefinitions>

			<!--  LEFT: controls  -->
			<DockPanel Grid.Column="0">

				<!--  Set selection (top)  -->
				<Grid DockPanel.Dock="Top" Margin="0,0,0,6">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="86" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Animation set:" />
					<ComboBox
						Grid.Row="0"
						Grid.Column="1"
						DisplayMemberPath="Name"
						ItemsSource="{Binding Sets}"
						SelectedItem="{Binding SelectedSet, Mode=TwoWay}" />
					<controls:SpacedStack
						Grid.Row="0"
						Grid.Column="2"
						Margin="6,0,0,0"
						Orientation="Horizontal"
						Spacing="{x:Static darkUI:Defaults.SmallThicknessWidth}">
						<Button Width="48" Command="{Binding NewSetCommand}" Content="New" ToolTip="Add new animation set" />
						<Button Width="52" Command="{Binding CloneSetCommand}" Content="Clone" ToolTip="Clone the current animation set" />
						<Button Width="56" Command="{Binding DeleteSetCommand}" Content="Delete" ToolTip="Delete the current animation set" />
					</controls:SpacedStack>
					<TextBlock Grid.Row="1" Grid.Column="0" Margin="0,6,0,0" VerticalAlignment="Center" Text="Name:" />
					<TextBox
						Grid.Row="1"
						Grid.Column="1"
						Grid.ColumnSpan="2"
						Margin="0,6,0,0"
						IsEnabled="{Binding HasSelectedSet}"
						Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
				</Grid>

				<!--  Settings (bottom)  -->
				<StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0" IsEnabled="{Binding HasSelectedSet}">
					<TextBlock Margin="0,0,0,2" Text="Settings" />
					<Border
						Padding="6"
						BorderBrush="{DynamicResource Brush_Border}"
						BorderThickness="1">
						<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="90" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="120" />
						</Grid.ColumnDefinitions>

						<TextBlock Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center" Text="Type:" />
						<ComboBox
							Grid.Column="1"
							ItemsSource="{Binding AnimationTypes}"
							SelectedItem="{Binding SelectedAnimationType, Mode=TwoWay}" />

						<TextBlock Grid.Column="2" Margin="10,0,6,0" VerticalAlignment="Center" Text="FPS:" />
						<Grid Grid.Column="3">
							<controls:NumericUpDown
								DecimalPlaces="2"
								IsEnabled="{Binding FpsNumericEnabled}"
								Maximum="120"
								Minimum="0"
								Value="{Binding Fps, Mode=TwoWay}"
								Visibility="{Binding ShowFpsNumeric, Converter={StaticResource BoolToVis}}" />
							<ComboBox
								DisplayMemberPath="Display"
								ItemsSource="{Binding NgFpsOptions}"
								SelectedItem="{Binding SelectedNgFps, Mode=TwoWay}"
								Visibility="{Binding ShowNgFpsCombo, Converter={StaticResource BoolToVis}}" />
							<controls:NumericUpDown
								DecimalPlaces="2"
								Maximum="120"
								Minimum="0"
								Value="{Binding TenUvRotateSpeed, Mode=TwoWay}"
								Visibility="{Binding ShowTeUvRotate, Converter={StaticResource BoolToVis}}" />
						</Grid>

						<TextBlock Grid.Column="4" Margin="10,0,6,0" VerticalAlignment="Center" Text="UvRotate:" />
						<Grid Grid.Column="5">
							<ComboBox
								DisplayMemberPath="Display"
								IsEnabled="{Binding NgUvRotateEnabled}"
								ItemsSource="{Binding NgUvRotateOptions}"
								SelectedItem="{Binding SelectedNgUvRotate, Mode=TwoWay}"
								Visibility="{Binding ShowNgUvRotateCombo, Converter={StaticResource BoolToVis}}" />
							<controls:NumericUpDown
								DecimalPlaces="0"
								Maximum="360"
								Minimum="-360"
								Value="{Binding TenUvRotateDirection, Mode=TwoWay}"
								Visibility="{Binding ShowTeUvRotate, Converter={StaticResource BoolToVis}}" />
						</Grid>
					</Grid>
				</Border>
				</StackPanel>

				<!--  Procedural tool + preview band (bottom)  -->
				<Grid DockPanel.Dock="Bottom" Margin="0,6,0,0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="6" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<!--  Procedural animation tool  -->
					<Border
						Grid.Column="0"
						Padding="6"
						BorderBrush="{DynamicResource Brush_Border}"
						BorderThickness="1">
						<StackPanel>
							<TextBlock Margin="0,0,0,4" Text="Procedural animation tool" />
							<Grid Margin="0,0,0,4">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="64" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Animator:" />
								<ComboBox
									Grid.Column="1"
									DisplayMemberPath="Display"
									ItemsSource="{Binding ProceduralPresets}"
									SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
									ToolTip="Animation type" />
							</Grid>
							<Grid Margin="0,0,0,4">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<TextBlock Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center" Text="Progress %:" />
								<controls:NumericUpDown Grid.Column="1" Maximum="100" Minimum="-100" ToolTip="Effect progress or strength" Value="{Binding GenStrength, Mode=TwoWay}" />
								<TextBlock Grid.Column="2" Margin="10,0,6,0" VerticalAlignment="Center" Text="Frames:" />
								<controls:NumericUpDown Grid.Column="3" Maximum="256" Minimum="1" ToolTip="Amount of resulting animation frames" Value="{Binding GenFrameCount, Mode=TwoWay}" />
							</Grid>
							<controls:SpacedStack Margin="0,0,0,4" Orientation="Horizontal" Spacing="{x:Static darkUI:Defaults.MediumThicknessWidth}">
								<CheckBox Content="Symmetric" IsChecked="{Binding GenLoop, Mode=TwoWay}" ToolTip="Make animation symmetric" />
								<CheckBox Content="Smooth" IsChecked="{Binding GenSmooth, Mode=TwoWay}" ToolTip="Ease-in and ease-out animation" />
							</controls:SpacedStack>
							<controls:SpacedStack Orientation="Horizontal" Spacing="{x:Static darkUI:Defaults.SmallThicknessWidth}">
								<Button Width="62" Command="{Binding GenerateNewCommand}" Content="Generate" ToolTip="Generate new animation" />
								<Button Width="52" Command="{Binding GenerateCloneCommand}" Content="Clone" IsEnabled="{Binding HasSelectedSet}" ToolTip="Generate and merge into copy of current animation" />
								<Button Width="56" Command="{Binding GenerateMergeCommand}" Content="Merge" IsEnabled="{Binding HasSelectedSet}" ToolTip="Generate and merge into current animation" />
								<Button Width="60" Command="{Binding GenerateReplaceCommand}" Content="Replace" IsEnabled="{Binding HasSelectedSet}" ToolTip="Generate and replace current animation" />
								<Button Width="44" Command="{Binding GenerateAddFramesCommand}" Content="Add" IsEnabled="{Binding HasSelectedSet}" ToolTip="Generate and add frames after current sequence frame" />
							</controls:SpacedStack>
						</StackPanel>
					</Border>

					<!--  Preview  -->
					<StackPanel Grid.Column="2">
						<TextBlock Margin="0,0,0,2" Text="Preview" />
						<Border
							Width="135"
							Height="135"
							Background="{DynamicResource Brush_Background_Low}"
							BorderBrush="{DynamicResource Brush_Border}"
							BorderThickness="1">
							<Image Source="{Binding PreviewImage}" Stretch="None" />
						</Border>
						<ProgressBar
							Height="16"
							Margin="0,4,0,0"
							Maximum="{Binding PreviewMaximum}"
							Minimum="0"
							Value="{Binding PreviewProgress}" />
					</StackPanel>
				</Grid>

				<!--  TRNG too-many-frames warning (bottom)  -->
				<TextBlock
					DockPanel.Dock="Bottom"
					Margin="0,6,0,0"
					Foreground="{DynamicResource Brush_Text_Warning}"
					Text="{Binding TooManyFramesText}"
					TextWrapping="Wrap"
					Visibility="{Binding TooManyFrames, Converter={StaticResource BoolToVis}}" />

				<!--  Frames header + frame buttons (top of remaining area)  -->
				<Grid DockPanel.Dock="Top" Margin="0,0,0,4">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Frames:" />
					<controls:SpacedStack
						Grid.Column="1"
						IsEnabled="{Binding HasSelectedSet}"
						Orientation="Horizontal"
						Spacing="{x:Static darkUI:Defaults.SmallThicknessWidth}">
						<Button Width="90" Command="{Binding AddFrameCommand}" Content="Add frame" ToolTip="Add the selected texture region as a new frame" />
						<Button Width="96" Command="{Binding UpdateFrameCommand}" Content="Update frame" ToolTip="Update the selected frame with the current texture region" />
					</controls:SpacedStack>
				</Grid>

				<!--  Frames grid (fills the centre)  -->
				<DataGrid
					x:Name="framesGrid"
					AutoGenerateColumns="False"
					CanUserAddRows="False"
					CanUserDeleteRows="True"
					IsEnabled="{Binding HasSelectedSet}"
					ItemsSource="{Binding Frames}"
					SelectedItem="{Binding SelectedFrame, Mode=TwoWay}">
					<DataGrid.Columns>
						<DataGridTemplateColumn Width="40" Header="Image">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<Image
										Width="32"
										Height="32"
										Source="{Binding Converter={StaticResource FrameThumb}}"
										Stretch="Uniform" />
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
						<DataGridTemplateColumn Width="*" Header="Texture">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<TextBlock Margin="4,0" VerticalAlignment="Center" Text="{Binding Texture}" TextTrimming="CharacterEllipsis" />
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
							<DataGridTemplateColumn.CellEditingTemplate>
								<DataTemplate>
									<ComboBox
										ItemsSource="{Binding DataContext.AvailableTextures, RelativeSource={RelativeSource AncestorType=DataGrid}}"
										SelectedItem="{Binding Texture, UpdateSourceTrigger=PropertyChanged}" />
								</DataTemplate>
							</DataGridTemplateColumn.CellEditingTemplate>
						</DataGridTemplateColumn>
						<DataGridTextColumn
							Width="Auto"
							Binding="{Binding Area}"
							Header="Area"
							IsReadOnly="True" />
						<DataGridTextColumn
							Width="60"
							Binding="{Binding Repeat, Mode=TwoWay}"
							Header="Repeat" />
					</DataGrid.Columns>
				</DataGrid>
			</DockPanel>

			<GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" />

			<!--  RIGHT: texture map  -->
			<DockPanel Grid.Column="2">
				<ComboBox
					DockPanel.Dock="Top"
					Margin="0,0,0,4"
					ItemsSource="{Binding AvailableTextures}"
					SelectedItem="{Binding CurrentTexture, Mode=TwoWay}" />
				<Border
					x:Name="textureMapContainer"
					Background="{DynamicResource Brush_Background_Low}"
					BorderBrush="{DynamicResource Brush_Border}"
					BorderThickness="1" />
			</DockPanel>
		</Grid>
	</DockPanel>
</Window>
