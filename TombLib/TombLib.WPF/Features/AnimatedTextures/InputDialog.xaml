<Window
	x:Class="TombLib.WPF.Features.AnimatedTextures.InputDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:DarkUI.WPF.CustomControls;assembly=DarkUI.WPF"
	xmlns:darkUI="clr-namespace:DarkUI.WPF;assembly=DarkUI.WPF"
	Width="340"
	Background="{DynamicResource Brush_Background}"
	ResizeMode="NoResize"
	ShowInTaskbar="False"
	SizeToContent="Height"
	Style="{DynamicResource CustomWindowStyle}"
	WindowStartupLocation="CenterOwner">
	<StackPanel Margin="{x:Static darkUI:Defaults.MediumThickness}">
		<TextBlock x:Name="label" Margin="0,0,0,6" />
		<TextBox x:Name="input" />
		<controls:SpacedStack
			Margin="0,12,0,0"
			HorizontalAlignment="Right"
			Orientation="Horizontal"
			Spacing="{x:Static darkUI:Defaults.MediumThicknessWidth}">
			<Button
				Width="80"
				Click="Ok_Click"
				Content="OK"
				IsDefault="True" />
			<Button
				Width="80"
				Content="Cancel"
				IsCancel="True" />
		</controls:SpacedStack>
	</StackPanel>
</Window>
