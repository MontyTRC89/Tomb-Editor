<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>TombLib.RenderingV2</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Configurations>Debug;Release</Configurations>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64;x86</Platforms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <OutputPath>..\..\Build ($(Platform))\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <OutputPath>..\..\BuildRelease ($(Platform))\</OutputPath>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='x64'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='x86'">
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\GlobalAssemblyInfo.cs">
      <Link>GlobalAssemblyInfo.cs</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <HlslShaderV2 Include="Shaders\Hello.hlsl">
      <EntryVs>vs_main</EntryVs>
      <EntryPs>ps_main</EntryPs>
    </HlslShaderV2>
    <HlslShaderV2 Include="Shaders\RoomGeometry.hlsl">
      <EntryVs>vs_main</EntryVs>
      <EntryPs>ps_main</EntryPs>
    </HlslShaderV2>
    <HlslShaderV2 Include="Shaders\Object.hlsl">
      <EntryVs>vs_main</EntryVs>
      <EntryPs>ps_main</EntryPs>
    </HlslShaderV2>
    <HlslShaderV2 Include="Shaders\Gizmo.hlsl">
      <EntryVs>vs_main</EntryVs>
      <EntryPs>ps_main</EntryPs>
    </HlslShaderV2>
    <HlslShaderV2 Include="Shaders\ServiceSprite.hlsl">
      <EntryVs>vs_main</EntryVs>
      <EntryPs>ps_main</EntryPs>
    </HlslShaderV2>
    <None Include="Shaders\*.hlsli" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.Core" Version="2.21.0" />
    <PackageReference Include="Silk.NET.Direct3D11" Version="2.21.0" />
    <PackageReference Include="Silk.NET.DXGI" Version="2.21.0" />
    <PackageReference Include="Silk.NET.Vulkan" Version="2.21.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.21.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.EXT" Version="2.21.0" />
  </ItemGroup>

  <Import Project="HlslShaderCompile.V2.targets" />
</Project>
