<Project Sdk="Microsoft.NET.Sdk">

  <!-- ImplicitUsings is intentionally enabled here (per-project policy; UI/TRX/Lua use explicit usings by design). -->
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Checked-in preview binaries (0.1.0-preview) under Libs/; not NuGet packages. Compatibility owned by the language-server integration. -->
  <ItemGroup>
    <Reference Include="Nickelony.LanguageServer.Abstractions">
      <HintPath>..\..\Libs\Nickelony.LanguageServer.Abstractions.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>