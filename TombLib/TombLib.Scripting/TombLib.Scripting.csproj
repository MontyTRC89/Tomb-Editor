<Project Sdk="Microsoft.NET.Sdk">

  <!-- ImplicitUsings is intentionally enabled here (per-project policy; UI/TRX/Lua use explicit usings by design). -->
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>CS1591</WarningsAsErrors>
  </PropertyGroup>

  <!-- Checked-in preview binary (0.1.0-preview) under Libs/; not a NuGet package. Version and
       build provenance are documented in Libs/README.md. -->
  <ItemGroup>
    <Reference Include="Nickelony.LanguageServer.Abstractions">
      <HintPath>..\..\Libs\Nickelony.LanguageServer.Abstractions.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>