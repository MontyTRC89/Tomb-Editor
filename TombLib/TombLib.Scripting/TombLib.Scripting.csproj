<Project Sdk="Microsoft.NET.Sdk">

  <!-- Neutral core: portable net8.0 (no Windows/WPF dependency) with explicit usings (repository standard). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>CS1591</WarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- Checked-in preview binary (0.1.0-preview) under Libs/; not a NuGet package. Version and
       build provenance are documented in Libs/README.md. -->
  <ItemGroup>
    <Reference Include="Nickelony.LanguageServer.Abstractions">
      <HintPath>..\..\Libs\Nickelony.LanguageServer.Abstractions.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>