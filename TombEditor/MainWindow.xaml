<Window
	x:Class="TombEditor.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
	xmlns:darkDock="clr-namespace:DarkUI.WPF.AvalonDock;assembly=DarkUI.WPF"
	xmlns:darkUI="clr-namespace:DarkUI.WPF;assembly=DarkUI.WPF"
	xmlns:editor="clr-namespace:TombEditor"
	xmlns:tomb="clr-namespace:TombLib.Icons;assembly=TombLib.Icons"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
	xmlns:contentBrowser="clr-namespace:TombEditor.Features.DockableViews.ContentBrowser"
	xmlns:importedGeometryBrowser="clr-namespace:TombEditor.Features.DockableViews.ImportedGeometryBrowser"
	xmlns:itemBrowser="clr-namespace:TombEditor.Features.DockableViews.ItemBrowser"
	xmlns:lightingPanel="clr-namespace:TombEditor.Features.DockableViews.LightingPanel"
	xmlns:objectList="clr-namespace:TombEditor.Features.DockableViews.ObjectList"
	xmlns:palettePanel="clr-namespace:TombEditor.Features.DockableViews.PalettePanel"
	xmlns:roomOptionsPanel="clr-namespace:TombEditor.Features.DockableViews.RoomOptionsPanel"
	xmlns:sectorOptionsPanel="clr-namespace:TombEditor.Features.DockableViews.SectorOptionsPanel"
	xmlns:texturePanel="clr-namespace:TombEditor.Features.DockableViews.TexturePanel"
	xmlns:triggerList="clr-namespace:TombEditor.Features.DockableViews.TriggerList"
	Title="Tomb Editor (WPF Preview)"
	Width="1280"
	Height="800"
	MinWidth="800"
	MinHeight="500"
	Style="{DynamicResource CustomWindowStyle}"
	WindowStartupLocation="CenterScreen"
	mc:Ignorable="d">

	<DockPanel LastChildFill="True">

		<!--
			Top: main editor menu. Mirrors FormMain.menuStrip 1:1. Each leaf MenuItem declares
			editor:EditorMenu.Command="<TagName>", which populates Header (FriendlyName) and
			InputGestureText (hotkey) at load via lookup into the same CommandHandler registry
			that the WinForms FormMain uses through GenerateMenusRecursive.
		-->
		<Menu DockPanel.Dock="Top">
			<MenuItem Header="File">
				<MenuItem editor:EditorMenu.Command="NewLevel" />
				<MenuItem editor:EditorMenu.Command="OpenLevel" />
				<MenuItem Header="Open recent" />
				<MenuItem editor:EditorMenu.Command="SaveLevel" />
				<MenuItem editor:EditorMenu.Command="SaveLevelAs" />
				<Separator />
				<MenuItem editor:EditorMenu.Command="ImportPrj" />
				<MenuItem editor:EditorMenu.Command="ConvertLevelToTombEngine" />
				<Separator />
				<MenuItem editor:EditorMenu.Command="BuildAndPlay" />
				<MenuItem editor:EditorMenu.Command="BuildLevel" />
				<Separator />
				<MenuItem editor:EditorMenu.Command="QuitEditor" />
			</MenuItem>

			<MenuItem Header="Edit">
				<MenuItem editor:EditorMenu.Command="Undo" />
				<MenuItem editor:EditorMenu.Command="Redo" />
				<Separator />
				<MenuItem editor:EditorMenu.Command="Cut" />
				<MenuItem editor:EditorMenu.Command="Copy" />
				<MenuItem editor:EditorMenu.Command="Paste" />
				<MenuItem editor:EditorMenu.Command="StampObject" />
				<MenuItem editor:EditorMenu.Command="Delete" />
				<MenuItem editor:EditorMenu.Command="SelectAll" />
				<Separator />
				<MenuItem editor:EditorMenu.Command="BookmarkObject" />
				<MenuItem editor:EditorMenu.Command="SelectBookmarkedObject" />
				<Separator />
				<MenuItem editor:EditorMenu.Command="EditObject" />
				<MenuItem editor:EditorMenu.Command="EditVolumeEventSets" />
				<MenuItem editor:EditorMenu.Command="EditGlobalEventSets" />
				<MenuItem editor:EditorMenu.Command="Search" />
				<MenuItem editor:EditorMenu.Command="SearchAndReplaceObjects" />
				<MenuItem editor:EditorMenu.Command="ShowFlybyTimeline" />
			</MenuItem>

			<MenuItem Header="View">
				<MenuItem editor:EditorMenu.Command="ResetCamera" />
				<MenuItem editor:EditorMenu.Command="RelocateCamera" />
				<MenuItem editor:EditorMenu.Command="ToggleFlyMode" />
				<Separator />
				<MenuItem editor:EditorMenu.Command="DrawWhiteTextureLightingOnly" />
				<MenuItem editor:EditorMenu.Command="ShowRealTintForObjects" />
			</MenuItem>

			<MenuItem Header="Rooms">
				<MenuItem Header="New room">
					<MenuItem editor:EditorMenu.Command="NewRoomUp" />
					<MenuItem editor:EditorMenu.Command="NewRoomDown" />
					<MenuItem editor:EditorMenu.Command="NewRoomLeft" />
					<MenuItem editor:EditorMenu.Command="NewRoomRight" />
					<MenuItem editor:EditorMenu.Command="NewRoomFront" />
					<MenuItem editor:EditorMenu.Command="NewRoomBack" />
				</MenuItem>
				<MenuItem editor:EditorMenu.Command="DuplicateRoom" />
				<MenuItem editor:EditorMenu.Command="CropRoom" />
				<MenuItem editor:EditorMenu.Command="SplitRoom" />
				<MenuItem editor:EditorMenu.Command="MergeRoomsHorizontally" />
				<MenuItem editor:EditorMenu.Command="DeleteRooms" />
				<Separator />
				<MenuItem Header="Move rooms">
					<MenuItem editor:EditorMenu.Command="MoveRoomUp" />
					<MenuItem editor:EditorMenu.Command="MoveRoomUp4Clicks" />
					<MenuItem editor:EditorMenu.Command="MoveRoomDown" />
					<MenuItem editor:EditorMenu.Command="MoveRoomDown4Clicks" />
					<MenuItem editor:EditorMenu.Command="MoveRoomLeft" />
					<MenuItem editor:EditorMenu.Command="MoveRoomRight" />
					<MenuItem editor:EditorMenu.Command="MoveRoomForward" />
					<MenuItem editor:EditorMenu.Command="MoveRoomBack" />
				</MenuItem>
				<MenuItem Header="Transform rooms">
					<MenuItem editor:EditorMenu.Command="RotateRoomsClockwise" />
					<MenuItem editor:EditorMenu.Command="RotateRoomsCounterClockwise" />
					<MenuItem editor:EditorMenu.Command="MirrorRoomsX" />
					<MenuItem editor:EditorMenu.Command="MirrorRoomsZ" />
				</MenuItem>
				<MenuItem Header="Select rooms">
					<MenuItem editor:EditorMenu.Command="SelectWaterRooms" />
					<MenuItem editor:EditorMenu.Command="SelectSkyRooms" />
					<MenuItem editor:EditorMenu.Command="SelectOutsideRooms" />
					<MenuItem editor:EditorMenu.Command="SelectQuicksandRooms" />
					<Separator />
					<MenuItem editor:EditorMenu.Command="SelectConnectedRooms" />
					<MenuItem editor:EditorMenu.Command="SelectRoomsByTags" />
				</MenuItem>
				<Separator />
				<MenuItem editor:EditorMenu.Command="ExportRooms" />
				<MenuItem editor:EditorMenu.Command="ImportRooms" />
				<MenuItem editor:EditorMenu.Command="ApplyRoomProperties" />
			</MenuItem>

			<MenuItem Header="Items">
				<MenuItem editor:EditorMenu.Command="AddWad" />
				<MenuItem editor:EditorMenu.Command="RemoveWads" />
				<MenuItem editor:EditorMenu.Command="ReloadWads" />
				<MenuItem editor:EditorMenu.Command="ReloadSounds" />
				<Separator />
				<MenuItem Header="Add item">
					<MenuItem editor:EditorMenu.Command="AddCamera" />
					<MenuItem editor:EditorMenu.Command="AddFlybyCamera" />
					<MenuItem editor:EditorMenu.Command="AddSprite" />
					<MenuItem editor:EditorMenu.Command="AddSink" />
					<MenuItem editor:EditorMenu.Command="AddSoundSource" />
					<MenuItem editor:EditorMenu.Command="AddImportedGeometry" />
					<MenuItem editor:EditorMenu.Command="AddGhostBlock" />
					<MenuItem editor:EditorMenu.Command="AddMemo" />
				</MenuItem>
				<MenuItem editor:EditorMenu.Command="AddPortal" />
				<MenuItem editor:EditorMenu.Command="AddTrigger" />
				<MenuItem editor:EditorMenu.Command="AddBoxVolume" />
				<MenuItem editor:EditorMenu.Command="AddSphereVolume" />
				<Separator />
				<MenuItem Header="Delete...">
					<MenuItem editor:EditorMenu.Command="DeleteAllLights" />
					<MenuItem editor:EditorMenu.Command="DeleteAllObjects" />
					<MenuItem editor:EditorMenu.Command="DeleteAllTriggers" />
					<MenuItem editor:EditorMenu.Command="DeleteMissingObjects" />
				</MenuItem>
				<Separator />
				<MenuItem editor:EditorMenu.Command="LocateItem" />
				<MenuItem editor:EditorMenu.Command="MoveLara" />
				<MenuItem editor:EditorMenu.Command="SelectAllObjectsInArea" />
				<MenuItem editor:EditorMenu.Command="SelectFloorBelowObject" />
				<MenuItem editor:EditorMenu.Command="SplitSectorObjectOnSelection" />
				<Separator />
				<MenuItem editor:EditorMenu.Command="SetStaticMeshesColorToRoomLight" />
				<MenuItem editor:EditorMenu.Command="SetStaticMeshesColor" />
				<Separator />
				<MenuItem editor:EditorMenu.Command="MakeQuickItemGroup" />
				<MenuItem editor:EditorMenu.Command="GetObjectStatistics" />
				<MenuItem editor:EditorMenu.Command="GenerateObjectNames" />
			</MenuItem>

			<MenuItem Header="Textures">
				<MenuItem editor:EditorMenu.Command="AddTexture" />
				<MenuItem editor:EditorMenu.Command="RemoveTextures" />
				<MenuItem editor:EditorMenu.Command="UnloadTextures" />
				<MenuItem editor:EditorMenu.Command="ReloadTextures" />
				<MenuItem editor:EditorMenu.Command="ConvertTexturesToPNG" />
				<MenuItem editor:EditorMenu.Command="RemapTexture" />
				<Separator />
				<MenuItem editor:EditorMenu.Command="TextureFloor" />
				<MenuItem editor:EditorMenu.Command="TextureWalls" />
				<MenuItem editor:EditorMenu.Command="TextureCeiling" />
				<Separator />
				<MenuItem editor:EditorMenu.Command="ClearAllTexturesInRoom" />
				<MenuItem editor:EditorMenu.Command="ClearAllTexturesInLevel" />
				<Separator />
				<MenuItem editor:EditorMenu.Command="SearchTextures" />
				<MenuItem editor:EditorMenu.Command="EditAnimationRanges" />
			</MenuItem>

			<MenuItem Header="Transform">
				<MenuItem editor:EditorMenu.Command="IncreaseStepHeight" />
				<MenuItem editor:EditorMenu.Command="DecreaseStepHeight" />
				<Separator />
				<MenuItem editor:EditorMenu.Command="SmoothRandomFloorUp" />
				<MenuItem editor:EditorMenu.Command="SmoothRandomFloorDown" />
				<MenuItem editor:EditorMenu.Command="SmoothRandomCeilingUp" />
				<MenuItem editor:EditorMenu.Command="SmoothRandomCeilingDown" />
				<Separator />
				<MenuItem editor:EditorMenu.Command="SharpRandomFloorUp" />
				<MenuItem editor:EditorMenu.Command="SharpRandomFloorDown" />
				<MenuItem editor:EditorMenu.Command="SharpRandomCeilingUp" />
				<MenuItem editor:EditorMenu.Command="SharpRandomCeilingDown" />
				<Separator />
				<MenuItem editor:EditorMenu.Command="RealignFloorToStepHeight" />
				<MenuItem editor:EditorMenu.Command="RealignCeilingToStepHeight" />
				<MenuItem editor:EditorMenu.Command="SmoothFloor" />
				<MenuItem editor:EditorMenu.Command="SmoothCeiling" />
				<MenuItem editor:EditorMenu.Command="AverageFloor" />
				<MenuItem editor:EditorMenu.Command="AverageCeiling" />
				<MenuItem editor:EditorMenu.Command="FlattenFloor" />
				<MenuItem editor:EditorMenu.Command="FlattenCeiling" />
				<MenuItem editor:EditorMenu.Command="ResetGeometry" />
				<Separator />
				<MenuItem editor:EditorMenu.Command="GridWallsIn3" />
				<MenuItem editor:EditorMenu.Command="GridWallsIn5" />
				<MenuItem editor:EditorMenu.Command="GridWallsIn3Squares" />
				<MenuItem editor:EditorMenu.Command="GridWallsIn5Squares" />
				<MenuItem editor:EditorMenu.Command="ConvertFloorToQuads" />
				<MenuItem editor:EditorMenu.Command="ConvertCeilingToQuads" />
			</MenuItem>

			<MenuItem Header="Tools">
				<MenuItem editor:EditorMenu.Command="EditLevelSettings" />
				<MenuItem editor:EditorMenu.Command="EditOptions" />
				<MenuItem editor:EditorMenu.Command="EditKeyboardLayout" />
				<Separator />
				<MenuItem editor:EditorMenu.Command="StartWadTool" />
				<MenuItem editor:EditorMenu.Command="StartSoundTool" />
			</MenuItem>

			<MenuItem Header="Window">
				<MenuItem Header="Layouts" />
				<Separator />
				<MenuItem editor:EditorMenu.Command="ShowSectorOptions" />
				<MenuItem editor:EditorMenu.Command="ShowRoomOptions" />
				<MenuItem editor:EditorMenu.Command="ShowItemBrowser" />
				<MenuItem editor:EditorMenu.Command="ShowImportedGeometryBrowser" />
				<MenuItem editor:EditorMenu.Command="ShowContentBrowser" />
				<MenuItem editor:EditorMenu.Command="ShowTriggerList" />
				<MenuItem editor:EditorMenu.Command="ShowLighting" />
				<MenuItem editor:EditorMenu.Command="ShowPalette" />
				<MenuItem editor:EditorMenu.Command="ShowTexturePanel" />
				<MenuItem editor:EditorMenu.Command="ShowObjectList" />
				<MenuItem editor:EditorMenu.Command="ShowStatistics" />
				<MenuItem editor:EditorMenu.Command="ShowToolPalette" />
				<MenuItem Header="Tool Palette (floating)" IsCheckable="True" />
			</MenuItem>

			<MenuItem Header="Help">
				<MenuItem Header="About Tomb Editor..." />
			</MenuItem>
		</Menu>

		<!--
			Top: editor toolbar. Mirrors the WinForms MainView toolbar (~50 buttons) one-for-one
			via CommandHandler — each Button's Command is resolved from the same registered
			TombEditor command name that the legacy WinForms toolbar binds via Tag.
		-->
		<Border
			Background="{DynamicResource Brush_Background_Low}"
			BorderBrush="{DynamicResource Brush_Border}"
			BorderThickness="0,0,0,1"
			DockPanel.Dock="Top">
			<ToolBarTray Orientation="Horizontal">
				<ToolBar>
					<!--
						Editor modes — ToggleButtons backed by Editor.Mode so the active mode stays
						visually pressed, matching the WinForms `butXxx.Checked = mode == EditorMode.X` pattern.
					-->
					<ToggleButton editor:EditorToolButton.Command="Switch2DMode" editor:EditorToolButton.ActiveMode="Map2D">
						<Image Source="{tomb:Icon Actions/2DView}" />
					</ToggleButton>
					<ToggleButton editor:EditorToolButton.Command="SwitchGeometryMode" editor:EditorToolButton.ActiveMode="Geometry">
						<Image Source="{tomb:Icon Actions/3DView}" />
					</ToggleButton>
					<ToggleButton editor:EditorToolButton.Command="SwitchFaceEditMode" editor:EditorToolButton.ActiveMode="FaceEdit">
						<Image Source="{tomb:Icon Actions/TextureMode}" />
					</ToggleButton>
					<ToggleButton editor:EditorToolButton.Command="SwitchObjectPlacementMode" editor:EditorToolButton.ActiveMode="ObjectPlacement">
						<Image Source="{tomb:Icon Toolbox/ObjectPlacement}" />
					</ToggleButton>
					<ToggleButton editor:EditorToolButton.Command="SwitchLightingMode" editor:EditorToolButton.ActiveMode="Lighting">
						<Image Source="{tomb:Icon Actions/light_on}" />
					</ToggleButton>
				</ToolBar>

				<ToolBar>
					<!--  Undo / Redo (one-shot)  -->
					<Button editor:EditorToolButton.Command="Undo">
						<Image Source="{tomb:Icon General/undo}" />
					</Button>
					<Button editor:EditorToolButton.Command="Redo">
						<Image Source="{tomb:Icon General/redo}" />
					</Button>
				</ToolBar>

				<ToolBar>
					<!--  Camera (Center is one-shot; FlyMode is a toggle but has no persisted config flag)  -->
					<Button editor:EditorToolButton.Command="ResetCamera">
						<Image Source="{tomb:Icon Actions/center_direction}" />
					</Button>
					<Button editor:EditorToolButton.Command="ToggleFlyMode">
						<Image Source="{tomb:Icon General/airplane}" />
					</Button>
				</ToolBar>

				<ToolBar>
					<!--  Draw flags — ToggleButtons reflect the persisted Rendering3D_* flags  -->
					<ToggleButton editor:EditorToolButton.Command="DrawPortals" editor:EditorToolButton.ConfigFlag="Rendering3D_ShowPortals">
						<Image Source="{tomb:Icon Actions/DrawPortals}" />
					</ToggleButton>
					<ToggleButton editor:EditorToolButton.Command="DrawAllRooms" editor:EditorToolButton.ConfigFlag="Rendering3D_ShowAllRooms">
						<Image Source="{tomb:Icon Actions/DrawAllRooms}" />
					</ToggleButton>
					<ToggleButton editor:EditorToolButton.Command="DrawHorizon" editor:EditorToolButton.ConfigFlag="Rendering3D_ShowHorizon">
						<Image Source="{tomb:Icon Actions/horizon}" />
					</ToggleButton>
					<ToggleButton editor:EditorToolButton.Command="DrawRoomNames" editor:EditorToolButton.ConfigFlag="Rendering3D_ShowRoomNames">
						<Image Source="{tomb:Icon Actions/generic_text}" />
					</ToggleButton>
					<ToggleButton editor:EditorToolButton.Command="DrawCardinalDirections" editor:EditorToolButton.ConfigFlag="Rendering3D_ShowCardinalDirections">
						<Image Source="{tomb:Icon Actions/DrawCardinalDirections}" />
					</ToggleButton>
					<ToggleButton editor:EditorToolButton.Command="DrawExtraBlendingModes" editor:EditorToolButton.ConfigFlag="Rendering3D_ShowExtraBlendingModes">
						<Image Source="{tomb:Icon Texture/Transparent_1}" />
					</ToggleButton>
					<ToggleButton editor:EditorToolButton.Command="HideTransparentFaces" editor:EditorToolButton.ConfigFlag="Rendering3D_HideTransparentFaces">
						<Image Source="{tomb:Icon Actions/AlphaTest}" />
					</ToggleButton>
					<ToggleButton editor:EditorToolButton.Command="BilinearFilter" editor:EditorToolButton.ConfigFlag="Rendering3D_BilinearFilter">
						<Image Source="{tomb:Icon General/blur}" />
					</ToggleButton>
					<ToggleButton editor:EditorToolButton.Command="DrawWhiteTextureLightingOnly" editor:EditorToolButton.ConfigFlag="Rendering3D_ShowLightingWhiteTextureOnly">
						<Image Source="{tomb:Icon Actions/DrawUntexturedLights}" />
					</ToggleButton>
					<ToggleButton editor:EditorToolButton.Command="ShowRealTintForObjects" editor:EditorToolButton.ConfigFlag="Rendering3D_ShowRealTintForObjects">
						<Image Source="{tomb:Icon Actions/StaticTint}" />
					</ToggleButton>
					<ToggleButton editor:EditorToolButton.Command="DrawIllegalSlopes" editor:EditorToolButton.ConfigFlag="Rendering3D_ShowIllegalSlopes">
						<Image Source="{tomb:Icon General/Warning}" />
					</ToggleButton>
					<ToggleButton editor:EditorToolButton.Command="DrawSlideDirections" editor:EditorToolButton.ConfigFlag="Rendering3D_ShowSlideDirections">
						<Image Source="{tomb:Icon Actions/Slide}" />
					</ToggleButton>
					<ToggleButton editor:EditorToolButton.Command="DisableGeometryPicking" editor:EditorToolButton.ConfigFlag="Rendering3D_DisablePickingForImportedGeometry">
						<Image Source="{tomb:Icon Actions/HideCustomGeometry_1}" />
					</ToggleButton>
					<ToggleButton editor:EditorToolButton.Command="DisableHiddenRoomPicking" editor:EditorToolButton.ConfigFlag="Rendering3D_DisablePickingForHiddenRooms">
						<Image Source="{tomb:Icon Actions/HideHiddenRooms}" />
					</ToggleButton>
				</ToolBar>

				<ToolBar>
					<!--  Flipmap + clipboard (one-shot)  -->
					<Button editor:EditorToolButton.Command="ToggleFlipMap">
						<Image Source="{tomb:Icon General/copy_link}" />
					</Button>
					<Button editor:EditorToolButton.Command="Copy">
						<Image Source="{tomb:Icon General/copy}" />
					</Button>
					<Button editor:EditorToolButton.Command="Paste">
						<Image Source="{tomb:Icon General/clipboard}" />
					</Button>
					<Button editor:EditorToolButton.Command="StampObject">
						<Image Source="{tomb:Icon Actions/rubber_stamp}" />
					</Button>
				</ToolBar>

				<ToolBar>
					<!--  Opacity toggles (one-shot — opacity is per-face state, not a global flag)  -->
					<Button editor:EditorToolButton.Command="ToggleNoOpacity">
						<Image Source="{tomb:Icon Texture/Solid}" />
					</Button>
					<Button editor:EditorToolButton.Command="ToggleOpacity">
						<Image Source="{tomb:Icon Texture/ToggleOpacity}" />
					</Button>
					<Button editor:EditorToolButton.Command="ToggleOpacity2">
						<Image Source="{tomb:Icon Texture/ToggleOpacity2}" />
					</Button>
					<Button editor:EditorToolButton.Command="ToggleClassicPortalMirror">
						<Image Source="{tomb:Icon Texture/MirrorPortal}" />
					</Button>
				</ToolBar>

				<ToolBar>
					<!--  Add object  -->
					<Button editor:EditorToolButton.Command="AddCamera">
						<Image Source="{tomb:Icon Objects/Camera}" />
					</Button>
					<Button editor:EditorToolButton.Command="AddSprite">
						<Image Source="{tomb:Icon Objects/Sprite}" />
					</Button>
					<Button editor:EditorToolButton.Command="AddFlybyCamera">
						<Image Source="{tomb:Icon Objects/movie_projector}" />
					</Button>
					<Button editor:EditorToolButton.Command="AddSink">
						<Image Source="{tomb:Icon Objects/tornado}" />
					</Button>
					<Button editor:EditorToolButton.Command="AddSoundSource">
						<Image Source="{tomb:Icon Objects/speaker}" />
					</Button>
					<Button editor:EditorToolButton.Command="AddImportedGeometry">
						<Image Source="{tomb:Icon Objects/custom-geometry}" />
					</Button>
					<Button editor:EditorToolButton.Command="AddGhostBlock">
						<Image Source="{tomb:Icon Objects/geometry-override}" />
					</Button>
					<Button editor:EditorToolButton.Command="AddMemo">
						<Image Source="{tomb:Icon Objects/Memo}" />
					</Button>
					<Button editor:EditorToolButton.Command="AddBoxVolume">
						<Image Source="{tomb:Icon Objects/volume-box}" />
					</Button>
					<Button editor:EditorToolButton.Command="AddSphereVolume">
						<Image Source="{tomb:Icon Objects/volume-sphere}" />
					</Button>
				</ToolBar>

				<ToolBar>
					<!--  Build  -->
					<Button editor:EditorToolButton.Command="BuildLevel">
						<Image Source="{tomb:Icon Actions/compile}" />
					</Button>
					<Button editor:EditorToolButton.Command="BuildAndPlay">
						<Image Source="{tomb:Icon Actions/play}" />
					</Button>
					<Button editor:EditorToolButton.Command="BuildAndPlayPreview">
						<Image Source="{tomb:Icon Actions/play_fast}" />
					</Button>
				</ToolBar>

				<ToolBar>
					<!--  Quick texture targets  -->
					<Button editor:EditorToolButton.Command="TextureFloor">
						<Image Source="{tomb:Icon Texture/Floor2}" />
					</Button>
					<Button editor:EditorToolButton.Command="TextureCeiling">
						<Image Source="{tomb:Icon Texture/Ceiling2}" />
					</Button>
					<Button editor:EditorToolButton.Command="TextureWalls">
						<Image Source="{tomb:Icon Texture/Walls2}" />
					</Button>
				</ToolBar>

				<ToolBar>
					<!--  Misc tools  -->
					<Button editor:EditorToolButton.Command="EditLevelSettings">
						<Image Source="{tomb:Icon General/settings}" />
					</Button>
					<Button editor:EditorToolButton.Command="Search">
						<Image Source="{tomb:Icon General/search}" />
					</Button>
					<Button editor:EditorToolButton.Command="SearchAndReplaceObjects">
						<Image Source="{tomb:Icon General/Find-and-replace}" />
					</Button>
				</ToolBar>
			</ToolBarTray>
		</Border>

		<!--  Bottom: Status bar (placeholder)  -->
		<StatusBar DockPanel.Dock="Bottom">
			<StatusBarItem>Ready</StatusBarItem>
			<StatusBarItem HorizontalAlignment="Right">
				<TextBlock Text="WPF Preview — FormMain is still the main editor shell" />
			</StatusBarItem>
		</StatusBar>

		<!--  Center: AvalonDock  -->
		<avalonDock:DockingManager x:Name="dockManager">
			<avalonDock:DockingManager.Theme>
				<darkDock:DarkUIDockTheme />
			</avalonDock:DockingManager.Theme>

			<avalonDock:LayoutRoot>
				<avalonDock:LayoutPanel Orientation="Horizontal">

					<!--  Left side: anchorables placeholders  -->
					<avalonDock:LayoutAnchorablePaneGroup DockWidth="260" Orientation="Vertical">
						<avalonDock:LayoutAnchorablePane>
							<avalonDock:LayoutAnchorable ContentId="rooms" Title="Rooms" CanClose="False">
								<TextBlock Margin="8" Text="Rooms panel (placeholder)" />
							</avalonDock:LayoutAnchorable>
							<avalonDock:LayoutAnchorable ContentId="objectList" Title="Objects in room" CanClose="False">
								<objectList:ObjectListView x:Name="objectListView" />
							</avalonDock:LayoutAnchorable>
						</avalonDock:LayoutAnchorablePane>
						<avalonDock:LayoutAnchorablePane>
							<avalonDock:LayoutAnchorable ContentId="sectorOptions" Title="Sector options" CanClose="False">
								<sectorOptionsPanel:SectorOptionsView x:Name="sectorOptionsView" />
							</avalonDock:LayoutAnchorable>
							<avalonDock:LayoutAnchorable ContentId="roomOptions" Title="Room options" CanClose="False">
								<roomOptionsPanel:RoomOptionsView x:Name="roomOptionsView" />
							</avalonDock:LayoutAnchorable>
							<avalonDock:LayoutAnchorable ContentId="triggerList" Title="Triggers" CanClose="False">
								<triggerList:TriggerListView x:Name="triggerListView" />
							</avalonDock:LayoutAnchorable>
						</avalonDock:LayoutAnchorablePane>
					</avalonDock:LayoutAnchorablePaneGroup>

					<!--  Center: viewport area — 3D View and 2D Map as sibling document tabs  -->
					<avalonDock:LayoutDocumentPaneGroup>
						<avalonDock:LayoutDocumentPane>
							<avalonDock:LayoutDocument
								x:Name="mainViewDocument"
								ContentId="mainView"
								CanClose="False"
								Title="3D View">
								<wfi:WindowsFormsHost x:Name="panel3DHost" Background="{DynamicResource Brush_Background_Low}" />
							</avalonDock:LayoutDocument>
							<avalonDock:LayoutDocument
								x:Name="map2DDocument"
								ContentId="map2DView"
								CanClose="False"
								Title="2D Map">
								<wfi:WindowsFormsHost x:Name="panel2DMapHost" Background="{DynamicResource Brush_Background_Low}" />
							</avalonDock:LayoutDocument>
						</avalonDock:LayoutDocumentPane>
