<Window
	x:Class="TombEditor.Features.Dialogs.Operation.OperationDialogWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:DarkUI.WPF.CustomControls;assembly=DarkUI.WPF"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:darkUI="clr-namespace:DarkUI.WPF;assembly=DarkUI.WPF"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
	xmlns:tombLib="clr-namespace:TombLib.WPF;assembly=TombLib.WPF"
	xmlns:vm="clr-namespace:TombEditor.Features.Dialogs.Operation"
	Title="{Binding Title}"
	Width="600"
	Height="420"
	MinWidth="480"
	MinHeight="320"
	d:DataContext="{d:DesignInstance Type=vm:OperationDialogWindowViewModel}"
	md:DialogServiceViews.IsRegistered="True"
	Background="{DynamicResource Brush_Background}"
	ShowInTaskbar="False"
	Style="{DynamicResource CustomWindowStyle}"
	WindowStartupLocation="CenterOwner"
	mc:Ignorable="d">

	<Window.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVis" />
	</Window.Resources>

	<controls:SpacedGrid
		Margin="{x:Static darkUI:Defaults.MediumThickness}"
		RowSpacing="{x:Static darkUI:Defaults.MediumThicknessWidth}">

		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<ListBox
			x:Name="LogList"
			Grid.Row="0"
			AlternationCount="0"
			Background="{DynamicResource Brush_Background_Low}"
			ItemsSource="{Binding LogEntries}"
			ScrollViewer.HorizontalScrollBarVisibility="Auto"
			ScrollViewer.VerticalScrollBarVisibility="Auto">
			<ListBox.ItemTemplate>
				<DataTemplate>
					<!--  Uniform dark background; severity is shown via text colour, not a per-line
						background, so warnings/errors no longer look like coloured stripes.  -->
					<TextBlock Text="{Binding Text}" TextWrapping="Wrap">
						<TextBlock.Style>
							<Style TargetType="TextBlock">
								<Setter Property="Foreground" Value="{DynamicResource Brush_Text}" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding Severity}" Value="Warning">
										<Setter Property="Foreground" Value="#FFE6C34C" />
									</DataTrigger>
									<DataTrigger Binding="{Binding Severity}" Value="Error">
										<Setter Property="Foreground" Value="#FFE66C6C" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</TextBlock.Style>
					</TextBlock>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>

		<ProgressBar
			Grid.Row="1"
			Height="18"
			Maximum="100"
			Minimum="0"
			Value="{Binding Progress}"
			Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVis}}" />

		<controls:SpacedStack
			Grid.Row="2"
			HorizontalAlignment="Right"
			Orientation="Horizontal"
			Spacing="{x:Static darkUI:Defaults.MediumThicknessWidth}">
			<Button
				x:Name="OkButton"
				Width="{x:Static darkUI:Defaults.StandardButtonWidth}"
				Command="{Binding OkCommand}"
				Content="{tombLib:Localize ~Common.OK}"
				IsDefault="True"
				IsEnabled="{Binding IsOkEnabled}" />
			<Button
				Width="{x:Static darkUI:Defaults.StandardButtonWidth}"
				Command="{Binding CancelCommand}"
				Content="{tombLib:Localize ~Common.Cancel}"
				IsCancel="True"
				IsEnabled="{Binding IsCancelEnabled}" />
		</controls:SpacedStack>
	</controls:SpacedGrid>
</Window>
