<Window
	x:Class="TombEditor.Features.Dialogs.Search.SearchWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:DarkUI.WPF.CustomControls;assembly=DarkUI.WPF"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:darkUI="clr-namespace:DarkUI.WPF;assembly=DarkUI.WPF"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:tombLib="clr-namespace:TombLib.WPF;assembly=TombLib.WPF"
	xmlns:vm="clr-namespace:TombEditor.Features.Dialogs.Search"
	Title="{tombLib:Localize Title}"
	Width="640"
	Height="520"
	MinWidth="540"
	MinHeight="400"
	d:DataContext="{d:DesignInstance Type=vm:SearchWindowViewModel}"
	Background="{DynamicResource Brush_Background}"
	ShowInTaskbar="False"
	Style="{DynamicResource CustomWindowStyle}"
	WindowStartupLocation="CenterOwner"
	mc:Ignorable="d">

	<controls:SpacedGrid
		Margin="{x:Static darkUI:Defaults.MediumThickness}"
		RowSpacing="{x:Static darkUI:Defaults.MediumThicknessWidth}">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<controls:SpacedGrid
			Grid.Row="0"
			ColumnSpacing="{x:Static darkUI:Defaults.SmallThicknessWidth}">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<Label
				Grid.Column="0"
				VerticalAlignment="Center"
				Content="{tombLib:Localize Scope}" />
			<ComboBox
				Grid.Column="1"
				ItemsSource="{Binding Scopes}"
				SelectedItem="{Binding Scope, Mode=TwoWay}" />
		</controls:SpacedGrid>

		<controls:SpacedGrid
			Grid.Row="1"
			ColumnSpacing="{x:Static darkUI:Defaults.SmallThicknessWidth}">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<Label
				Grid.Column="0"
				VerticalAlignment="Center"
				Content="{tombLib:Localize Keyword}" />
			<TextBox
				Grid.Column="1"
				VerticalAlignment="Center"
				Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" />
		</controls:SpacedGrid>

		<DataGrid
			Grid.Row="2"
			AutoGenerateColumns="False"
			CanUserAddRows="False"
			CanUserDeleteRows="False"
			IsReadOnly="True"
			ItemsSource="{Binding Rows}"
			SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
			SelectionMode="Single">
			<DataGrid.Columns>
				<DataGridTextColumn
					Width="*"
					Binding="{Binding Name}"
					Header="{tombLib:Localize ColumnName}" />
				<DataGridTextColumn
					Width="160"
					Binding="{Binding Room}"
					Header="{tombLib:Localize ColumnRoom}" />
				<DataGridTextColumn
					Width="100"
					Binding="{Binding Type}"
					Header="{tombLib:Localize ColumnType}" />
			</DataGrid.Columns>
		</DataGrid>

		<controls:SpacedStack
			Grid.Row="3"
			HorizontalAlignment="Right"
			Orientation="Horizontal"
			Spacing="{x:Static darkUI:Defaults.MediumThicknessWidth}">
			<Button
				Width="{x:Static darkUI:Defaults.StandardButtonWidth}"
				Command="{Binding DeleteSelectedCommand}"
				Content="{tombLib:Localize Delete}" />
			<Button
				Width="{x:Static darkUI:Defaults.StandardButtonWidth}"
				Click="CloseButton_Click"
				Content="{tombLib:Localize ~Common.Close}"
				IsCancel="True" />
		</controls:SpacedStack>
	</controls:SpacedGrid>
</Window>
