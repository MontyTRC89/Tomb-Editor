<Window
	x:Class="TombEditor.Views.WadPreviewWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:darkUI="clr-namespace:DarkUI.WPF;assembly=DarkUI.WPF"
	xmlns:controls="clr-namespace:DarkUI.WPF.CustomControls;assembly=DarkUI.WPF"
	xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
	Width="683"
	Height="400"
	Background="{DynamicResource Brush_Background}"
	ResizeMode="NoResize"
	ShowInTaskbar="False"
	WindowStartupLocation="Manual"
	WindowStyle="None">

	<Border
		Margin="{x:Static darkUI:Defaults.TinyThickness}"
		BorderBrush="{DynamicResource Brush_Border}"
		BorderThickness="{x:Static darkUI:Defaults.BorderThickness}">

		<controls:SpacedGrid
			Margin="{x:Static darkUI:Defaults.TinyThickness}"
			ColumnSpacing="{x:Static darkUI:Defaults.SmallThicknessWidth}">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="280" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<wfi:WindowsFormsHost x:Name="wadTreeHost" Grid.Column="0" />
			<wfi:WindowsFormsHost x:Name="panelItemHost" Grid.Column="1" />
		</controls:SpacedGrid>
	</Border>
</Window>
