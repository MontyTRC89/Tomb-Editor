<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <PropertyGroup>
    <LuaLanguageServerArchivePath>$(MSBuildProjectDirectory)\TIDE\LuaLS.zip</LuaLanguageServerArchivePath>
  </PropertyGroup>

  <ItemGroup>
    <LuaLanguageServerRepresentativeOutput Include="bin\lua-language-server.exe" />
    <LuaLanguageServerRepresentativeOutput Include="main.lua" />
    <LuaLanguageServerRepresentativeOutput Include="script\cli\check_worker.lua" />
    <LuaLanguageServerRepresentativeOutput Include="locale\en-us\script.lua" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\GlobalPaths.cs">
      <Link>GlobalPaths.cs</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\DarkUI\DarkUI.WPF\DarkUI.WPF.csproj" />
    <ProjectReference Include="..\..\DarkUI\DarkUI\DarkUI.csproj" />
    <ProjectReference Include="..\..\LuaApiBuilder\LuaApiBuilder.csproj" />
    <ProjectReference Include="..\..\TombLib\TombLib\TombLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\Localization\EN\TombIDE.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <Content Include="Resources\Localization\PL\TombIDE.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Update="TIDE\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Update="TIDE\LuaLS.zip">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>

    <None Update="TIDE\LuaLS\**\*">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="ExtractLuaLanguageServer"
          AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="$(LuaLanguageServerArchivePath)"
          Outputs="@(LuaLanguageServerRepresentativeOutput -> '$(TargetDir)TIDE\LuaLS\%(Identity)');$(TargetDir)TIDE\LuaLS\.extracted">
    <PropertyGroup>
      <LuaLanguageServerOutputDirectory>$(TargetDir)TIDE\LuaLS</LuaLanguageServerOutputDirectory>
      <LuaLanguageServerExtractionStampFile>$(LuaLanguageServerOutputDirectory)\.extracted</LuaLanguageServerExtractionStampFile>
    </PropertyGroup>

    <Error Condition="!Exists('$(LuaLanguageServerArchivePath)')"
           Text="LuaLS archive not found at '$(LuaLanguageServerArchivePath)'." />
    <RemoveDir Directories="$(LuaLanguageServerOutputDirectory)"
               Condition="Exists('$(LuaLanguageServerOutputDirectory)')" />
    <MakeDir Directories="$(LuaLanguageServerOutputDirectory)" />

    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;Expand-Archive -LiteralPath '$(LuaLanguageServerArchivePath)' -DestinationPath '$(LuaLanguageServerOutputDirectory)' -Force&quot;" />

    <ItemGroup>
      <_LuaLanguageServerRepresentativeOutputPath Include="@(LuaLanguageServerRepresentativeOutput -> '$(LuaLanguageServerOutputDirectory)\%(Identity)')" />
    </ItemGroup>

    <Error Condition="!Exists('%(_LuaLanguageServerRepresentativeOutputPath.Identity)')"
           Text="LuaLS archive '$(LuaLanguageServerArchivePath)' did not produce required file '%(_LuaLanguageServerRepresentativeOutputPath.Identity)'." />
    <Touch Files="@(_LuaLanguageServerRepresentativeOutputPath)" />
    <Touch Files="$(LuaLanguageServerExtractionStampFile)"
           AlwaysCreate="true" />

    <ItemGroup>
      <_LuaLanguageServerOutputFiles Include="$(LuaLanguageServerOutputDirectory)\**\*" />
      <FileWrites Include="@(_LuaLanguageServerOutputFiles)" />
      <FileWrites Include="$(LuaLanguageServerExtractionStampFile)" />
    </ItemGroup>
  </Target>

</Project>
