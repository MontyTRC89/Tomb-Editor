<UserControl x:Class="WadTool.Controls.WpfWadTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:darkUI="clr-namespace:DarkUI.WPF;assembly=DarkUI.WPF"
             mc:Ignorable="d"
             SnapsToDevicePixels="{x:Static darkUI:Defaults.SnapsToDevicePixels}"
             UseLayoutRounding="{x:Static darkUI:Defaults.UseLayoutRounding}"
             d:DesignHeight="647" d:DesignWidth="288">

    <Grid Background="{DynamicResource Brush_Background}">
        <!-- Placeholder shown when no WAD is loaded. -->
        <TextBlock x:Name="placeholderText"
                   Text="Click here to load new wad file."
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource Brush_Border}"
                   Visibility="Visible"
                   MouseLeftButtonUp="Placeholder_Click" />

        <!-- Main content shown when a WAD is loaded. -->
        <DockPanel x:Name="mainContent" Visibility="Collapsed">
            <!-- Top: Game version selector. -->
            <Grid DockPanel.Dock="Top" Margin="3,3,3,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Game version:"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0" />
                <ComboBox x:Name="gameVersionComboBox"
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          SelectionChanged="GameVersion_SelectionChanged" />
                <Button x:Name="butSearch"
                        Grid.Column="2"
                        MinWidth="21" MinHeight="21"
                        Margin="4,0,0,0"
                        ToolTip="Search"
                        Click="SearchButton_Click">
                    <Image Source="/Resources/search-16.png" Width="16" Height="16"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Button>
            </Grid>

            <!-- Bottom: Metadata (date + notes). -->
            <Grid DockPanel.Dock="Bottom" Margin="3,0,3,3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Date:" VerticalAlignment="Center" Margin="0,4,4,4" />
                <TextBox x:Name="tbDate" Grid.Column="1" IsReadOnly="True"
                         VerticalAlignment="Center" Margin="0,4,0,4" />

                <TextBlock Text="Notes:" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,4,4" />
                <TextBox x:Name="tbNotes" Grid.Row="1" Grid.Column="1"
                         VerticalAlignment="Center" Margin="0,0,0,4"
                         TextChanged="Notes_TextChanged" />
            </Grid>

            <!-- Center: Tree view. -->
            <TreeView x:Name="treeView"
                      Margin="3"
                      BorderThickness="0"
                      Background="Transparent"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      SelectedItemChanged="TreeView_SelectedItemChanged"
                      MouseDoubleClick="TreeView_MouseDoubleClick"
                      KeyDown="TreeView_KeyDown"
                      PreviewMouseLeftButtonDown="TreeView_PreviewMouseLeftButtonDown" />
        </DockPanel>
    </Grid>
</UserControl>
