<Window
	x:Class="WadTool.Features.Dialogs.AnimEditor.AnimationEditorWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:DarkUI.WPF.CustomControls;assembly=DarkUI.WPF"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:darkUI="clr-namespace:DarkUI.WPF;assembly=DarkUI.WPF"
	xmlns:local="clr-namespace:WadTool.Features.Dialogs.AnimEditor"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
	Title="{Binding Title}"
	Width="1100"
	Height="720"
	MinWidth="900"
	MinHeight="600"
	d:DataContext="{d:DesignInstance Type=local:AnimationEditorWindowViewModel}"
	Background="{DynamicResource Brush_Background}"
	ShowInTaskbar="False"
	Style="{DynamicResource CustomWindowStyle}"
	WindowStartupLocation="CenterOwner"
	mc:Ignorable="d">

	<Window.Resources>
		<Style x:Key="Lbl" TargetType="TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource Brush_Text_Low}" />
			<Setter Property="Margin" Value="0,4,0,0" />
		</Style>
		<Style x:Key="Val" TargetType="TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource Brush_Text}" />
		</Style>
	</Window.Resources>

	<DockPanel Margin="{x:Static darkUI:Defaults.MediumThickness}" LastChildFill="True">

		<!--  Footer: OK / Cancel  -->
		<controls:SpacedStack
			DockPanel.Dock="Bottom"
			HorizontalAlignment="Right"
			Orientation="Horizontal"
			Spacing="{x:Static darkUI:Defaults.MediumThicknessWidth}">
			<controls:SpacedStack.Margin>
				<Thickness Top="{x:Static darkUI:Defaults.MediumThicknessWidth}" />
			</controls:SpacedStack.Margin>
			<Button Width="80" Command="{Binding OkCommand}" Content="OK" IsDefault="True" />
			<Button Width="80" Command="{Binding CancelCommand}" Content="Cancel" IsCancel="True" />
		</controls:SpacedStack>

		<!--  Left: animation list  -->
		<GroupBox
			Width="240"
			DockPanel.Dock="Left"
			Header="Animations">
			<GroupBox.Margin>
				<Thickness Right="{x:Static darkUI:Defaults.MediumThicknessWidth}" />
			</GroupBox.Margin>
			<ListBox
				DisplayMemberPath="Label"
				ItemsSource="{Binding Animations}"
				SelectedItem="{Binding SelectedAnim, Mode=TwoWay}" />
		</GroupBox>

		<!--  Right: properties + blend curve  -->
		<GroupBox
			Width="220"
			DockPanel.Dock="Right"
			Header="Animation">
			<GroupBox.Margin>
				<Thickness Left="{x:Static darkUI:Defaults.MediumThicknessWidth}" />
			</GroupBox.Margin>
			<StackPanel>
				<TextBlock Style="{StaticResource Lbl}" Text="Name" />
				<TextBlock Style="{StaticResource Val}" Text="{Binding AnimName}" />
				<TextBlock Style="{StaticResource Lbl}" Text="Frame rate" />
				<TextBlock Style="{StaticResource Val}" Text="{Binding FrameRate}" />
				<TextBlock Style="{StaticResource Lbl}" Text="End frame" />
				<TextBlock Style="{StaticResource Val}" Text="{Binding EndFrame}" />
				<TextBlock Style="{StaticResource Lbl}" Text="Next animation" />
				<TextBlock Style="{StaticResource Val}" Text="{Binding NextAnim}" />
				<TextBlock Style="{StaticResource Lbl}" Text="Next frame" />
				<TextBlock Style="{StaticResource Val}" Text="{Binding NextFrame}" />
				<TextBlock Style="{StaticResource Lbl}" Text="State ID" />
				<TextBlock Style="{StaticResource Val}" Text="{Binding StateId}" />
				<Border
					Height="120"
					Margin="0,8,0,0"
					BorderBrush="{DynamicResource Brush_Border}"
					BorderThickness="1">
					<wfi:WindowsFormsHost x:Name="bezierHost" />
				</Border>
			</StackPanel>
		</GroupBox>

		<!--  Center: 3D view + timeline + transport  -->
		<DockPanel LastChildFill="True">

			<!--  Transport + status  -->
			<Grid DockPanel.Dock="Bottom">
				<Grid.Margin>
					<Thickness Top="{x:Static darkUI:Defaults.SmallThicknessWidth}" />
				</Grid.Margin>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<controls:SpacedStack Grid.Column="0" Orientation="Horizontal" Spacing="3">
					<Button Width="34" Command="{Binding GotoStartCommand}" Content="⏮" />
					<Button Width="34" Command="{Binding GotoPrevCommand}" Content="◀" />
					<Button Width="44" Command="{Binding PlayCommand}" Content="▶ / ⏹" />
					<Button Width="34" Command="{Binding GotoNextCommand}" Content="▶" />
					<Button Width="34" Command="{Binding GotoEndCommand}" Content="⏭" />
				</controls:SpacedStack>
				<TextBlock
					Grid.Column="1"
					Margin="10,0,0,0"
					VerticalAlignment="Center"
					Foreground="{DynamicResource Brush_Text_Low}"
					Text="{Binding StatusText}"
					TextTrimming="CharacterEllipsis" />
			</Grid>

			<!--  Timeline (hosted AnimationTrackBar)  -->
			<Border
				Height="84"
				DockPanel.Dock="Bottom"
				BorderBrush="{DynamicResource Brush_Border}"
				BorderThickness="1">
				<Border.Margin>
					<Thickness Top="{x:Static darkUI:Defaults.SmallThicknessWidth}" />
				</Border.Margin>
				<wfi:WindowsFormsHost x:Name="timelineHost" />
			</Border>

			<!--  3D view (hosted)  -->
			<Border BorderBrush="{DynamicResource Brush_Border}" BorderThickness="1">
				<wfi:WindowsFormsHost x:Name="panelRenderingHost" />
			</Border>
		</DockPanel>
	</DockPanel>
</Window>
