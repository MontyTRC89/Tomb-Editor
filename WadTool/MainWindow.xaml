<Window x:Class="WadTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WadTool.Controls"
        xmlns:darkUI="clr-namespace:DarkUI.WPF;assembly=DarkUI.WPF"
        xmlns:viewModels="clr-namespace:WadTool.ViewModels"
        d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}"
        mc:Ignorable="d"
        Style="{DynamicResource CustomWindowStyle}"
        Icon="WT.ico"
        Title="{Binding WindowTitle}"
        Width="1244" Height="742"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="{x:Static darkUI:Defaults.SnapsToDevicePixels}"
        UseLayoutRounding="{x:Static darkUI:Defaults.UseLayoutRounding}"
        Closing="Window_Closing">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewWadCommand}" />
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenSourceCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+O" Command="{Binding OpenDestinationCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
    </Window.InputBindings>

    <DockPanel LastChildFill="True">
        <!-- Menu bar. -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="New Wad2" InputGestureText="Ctrl+N" Command="{Binding NewWadCommand}" />
                <Separator />
                <MenuItem Header="Open source" InputGestureText="Ctrl+O" Command="{Binding OpenSourceCommand}" />
                <MenuItem Header="Open destination" InputGestureText="Ctrl+Shift+O" Command="{Binding OpenDestinationCommand}" />
                <MenuItem x:Name="menuOpenRecent" Header="Open recent..." />
                <MenuItem Header="Open reference Tomb Editor project" Command="{Binding OpenRefLevelCommand}" />
                <MenuItem Header="Close reference Tomb Editor project"
                          IsEnabled="{Binding CloseRefLevelEnabled}" Command="{Binding CloseRefLevelCommand}" />
                <Separator />
                <MenuItem Header="Save Wad2" InputGestureText="Ctrl+S"
                          IsEnabled="{Binding SaveEnabled}" Command="{Binding SaveCommand}" />
                <MenuItem Header="Save Wad2 as..." InputGestureText="Ctrl+Shift+S"
                          IsEnabled="{Binding SaveAsEnabled}" Command="{Binding SaveAsCommand}" />
                <Separator />
                <MenuItem Header="Exit" InputGestureText="Alt+F4" Command="{Binding ExitApplicationCommand}" />
            </MenuItem>
            <MenuItem Header="Create">
                <MenuItem Header="New moveable" Command="{Binding NewMoveableCommand}" />
                <MenuItem Header="New static" Command="{Binding NewStaticCommand}" />
                <MenuItem Header="New sprite sequence" Command="{Binding NewSpriteSequenceCommand}" />
            </MenuItem>
            <MenuItem Header="Selection">
                <MenuItem Header="Lighting">
                    <MenuItem Header="Convert to static"
                              IsEnabled="{Binding SelectionActionsEnabled}"
                              Command="{Binding ConvertToStaticLightingCommand}" />
                    <MenuItem Header="Convert to dynamic"
                              IsEnabled="{Binding SelectionActionsEnabled}"
                              Command="{Binding ConvertToDynamicLightingCommand}" />
                </MenuItem>
                <MenuItem Header="Textures">
                    <MenuItem Header="Convert to tiled"
                              IsEnabled="{Binding SelectionActionsEnabled}"
                              Command="{Binding ConvertToTiledCommand}" />
                    <MenuItem Header="Convert to UV-mapped"
                              IsEnabled="{Binding SelectionActionsEnabled}"
                              Command="{Binding ConvertToUVMappedCommand}" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Tools">
                <MenuItem Header="Animated textures"
                          IsEnabled="{Binding HasDestinationWad}" Click="AnimatedTextures_Click" />
                <MenuItem Header="Mesh editor"
                          IsEnabled="{Binding HasDestinationWad}" Click="MeshEditor_Click" />
                <Separator />
                <MenuItem Header="Convert wad to TombEngine..."
                          IsEnabled="{Binding HasDestinationWad}" Click="ConvertToTEN_Click" />
                <Separator />
                <MenuItem Header="Options..." Click="Options_Click" />
            </MenuItem>
            <MenuItem Header="Help">
                <MenuItem Header="About Wad Tool..." Click="About_Click" />
            </MenuItem>
            <MenuItem x:Name="menuDebug" Header="Debug" Visibility="Collapsed">
                <MenuItem Header="Debug action 0" Click="DebugAction0_Click" />
                <MenuItem Header="Debug action 1" Click="DebugAction1_Click" />
                <MenuItem Header="Debug action 2" Click="DebugAction2_Click" />
                <MenuItem Header="Debug action 3" Click="DebugAction3_Click" />
                <MenuItem Header="Debug action 4" Click="DebugAction4_Click" />
                <MenuItem Header="Debug action 5" Click="DebugAction5_Click" />
                <MenuItem Header="Debug action 6" Click="DebugAction6_Click" />
                <MenuItem Header="Debug action 7" Click="DebugAction7_Click" />
                <MenuItem Header="Debug action 8" Click="DebugAction8_Click" />
                <MenuItem Header="Debug action 9" Click="DebugAction9_Click" />
            </MenuItem>
        </Menu>

        <!-- Toolbar. -->
        <ToolBarTray DockPanel.Dock="Top" IsLocked="True">
            <ToolBar Band="0" BandIndex="0">
                <TextBlock Text="Destination:" VerticalAlignment="Center" Margin="2,0,4,0" />
                <Button ToolTip="New empty Wad2" Command="{Binding NewWadCommand}">
                    <Image Source="/Resources/create_new-16.png" Width="16" Height="16" />
                </Button>
                <Button ToolTip="Open destination file" Command="{Binding OpenDestinationCommand}">
                    <Image Source="/Resources/opened_folder-16.png" Width="16" Height="16" />
                </Button>
                <Button ToolTip="Save Wad2" IsEnabled="{Binding SaveEnabled}" Command="{Binding SaveCommand}">
                    <Image Source="/Resources/save-16.png" Width="16" Height="16" />
                </Button>
                <Button ToolTip="Save Wad2 as..." IsEnabled="{Binding SaveAsEnabled}" Command="{Binding SaveAsCommand}">
                    <Image Source="/Resources/save_as-16.png" Width="16" Height="16" />
                </Button>
                <Separator />
                <TextBlock Text="Source:" VerticalAlignment="Center" Margin="2,0,4,0" />
                <Button ToolTip="Open source file" Command="{Binding OpenSourceCommand}">
                    <Image Source="/Resources/opened_folder-16.png" Width="16" Height="16" />
                </Button>
                <Separator />
                <TextBlock Text="Reference project:" VerticalAlignment="Center" Margin="2,0,4,0" />
                <TextBlock Text="{Binding RefLevelText}" VerticalAlignment="Center"
                           Margin="0,0,4,0" Opacity="{Binding RefLevelOpacity}"
                           MouseLeftButtonUp="RefLevelLabel_Click" />
                <Button ToolTip="Open reference project" Command="{Binding OpenRefLevelCommand}">
                    <Image Source="/Resources/opened_folder-16.png" Width="16" Height="16" />
                </Button>
                <Button ToolTip="Close reference project"
                        IsEnabled="{Binding CloseRefLevelEnabled}" Command="{Binding CloseRefLevelCommand}">
                    <Image Source="/Resources/trash-16.png" Width="16" Height="16" />
                </Button>
            </ToolBar>
        </ToolBarTray>

        <!-- Status bar. -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
        </StatusBar>

        <!-- Main content area: 3-column layout. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="26*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="48*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="26*" />
            </Grid.ColumnDefinitions>

            <!-- Left panel: Destination. -->
            <DockPanel Grid.Column="0" LastChildFill="True">
                <ToolBarTray DockPanel.Dock="Bottom" IsLocked="True">
                    <ToolBar Band="0" BandIndex="0">
                        <Button Command="{Binding EditItemCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Resources/edit-16.png" Width="16" Height="16" Margin="0,0,4,0" />
                                <TextBlock Text="Edit item" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ChangeSlotCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Resources/copy-16.png" Width="16" Height="16" Margin="0,0,4,0" />
                                <TextBlock Text="Change slot" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DeleteObjectCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Resources/trash-16.png" Width="16" Height="16" Margin="0,0,4,0" />
                                <TextBlock Text="Delete" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </ToolBar>
                </ToolBarTray>
                <GroupBox Header="Destination">
                    <local:WpfWadTreeView x:Name="treeDestWad" />
                </GroupBox>
            </DockPanel>

            <Border Grid.Column="1" Background="{DynamicResource Brush_Border_Low}" />

            <!-- Center panel: 3D preview. -->
            <DockPanel Grid.Column="2" LastChildFill="True">
                <ToolBarTray DockPanel.Dock="Bottom" IsLocked="True">
                    <ToolBar Band="0" BandIndex="0">
                        <Button Visibility="{Binding EditAnimationsVisible, Converter={StaticResource BoolToVis}}"
                                Command="{Binding EditAnimationsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Resources/animations-16.png" Width="16" Height="16" Margin="0,0,4,0" />
                                <TextBlock Text="Edit animations" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Visibility="{Binding EditSkeletonVisible, Converter={StaticResource BoolToVis}}"
                                Command="{Binding EditSkeletonCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Resources/skeleton-16.png" Width="16" Height="16" Margin="0,0,4,0" />
                                <TextBlock Text="Edit skeleton" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Visibility="{Binding EditStaticModelVisible, Converter={StaticResource BoolToVis}}"
                                Command="{Binding EditStaticModelCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Resources/edit-16.png" Width="16" Height="16" Margin="0,0,4,0" />
                                <TextBlock Text="Edit static model" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Visibility="{Binding EditSpriteSequenceVisible, Converter={StaticResource BoolToVis}}"
                                Command="{Binding EditSpriteSequenceCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Resources/movie_projector-16.png" Width="16" Height="16" Margin="0,0,4,0" />
                                <TextBlock Text="Edit sprite sequence" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </ToolBar>
                </ToolBarTray>
                <Border BorderBrush="{DynamicResource MainBorder}" BorderThickness="1">
                    <local:WpfItemPreview x:Name="panel3D" />
                </Border>
            </DockPanel>

            <Border Grid.Column="3" Background="{DynamicResource Brush_Border_Low}" />

            <!-- Right panel: Source. -->
            <DockPanel Grid.Column="4" LastChildFill="True">
                <ToolBarTray DockPanel.Dock="Bottom" IsLocked="True">
                    <ToolBar Band="0" BandIndex="0">
                        <Button Command="{Binding AddObjectCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Resources/angle_left-16.png" Width="16" Height="16" Margin="0,0,4,0" />
                                <TextBlock Text="Add object" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding AddObjectToDifferentSlotCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Resources/angle_left-16.png" Width="16" Height="16" Margin="0,0,4,0" />
                                <TextBlock Text="Add object to different slot" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </ToolBar>
                </ToolBarTray>
                <GroupBox Header="{Binding SourceHeader}">
                    <local:WpfWadTreeView x:Name="treeSourceWad" />
                </GroupBox>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
